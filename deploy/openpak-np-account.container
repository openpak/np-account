# Sample only. Copy to ~/.config/containers/systemd/openpak-np-account.container.
# Use a separate env file per service; do not share NP_HTTP_ADDR or OAuth secrets.
[Unit]
Description=OpenPak np-account

[Container]
ContainerName=openpak-np-account
Image=ghcr.io/openpak/np-account:latest
Network=openpak
EnvironmentFile=%h/openpak/deploy/np-account.env
Environment=NP_HTTP_ADDR=:8002
Volume=%h/openpak/deploy/ps3-keys:/run/ps3:ro
Environment=NP_COMMUNITY_URL=http://openpak-np-community:8003
Environment=NP_TROPHY_URL=http://openpak-np-trophy:8531
Environment=NP_TLS_ADDR=:8443
Environment=NP_TLS_CA_CERT=/run/ps3/ca.crt
Environment=NP_TLS_CA_KEY=/run/ps3/ca.key

[Service]
Restart=on-failure

[Install]
WantedBy=default.target

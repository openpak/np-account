# Account core internal gRPC address + shared credential (>= 32 bytes).
NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!

# Sony's OAuth client credentials, embedded in the PS3 firmware's np_oauth module.
# Supply the real values here on the operator side; never commit them.
NP_CLIENT_ID=change-me
NP_CLIENT_SECRET=change-me

# Signs every token issued here (>= 32 bytes). Rotating it signs everyone out.
NP_TOKEN_KEY=change-me-token-signing-key-change-me-please!

NP_HTTP_ADDR=:8002

# Optional.
# NP_ENV_ISS_ID=1
# NP_COMM_DOMAIN=00
# NP_AUTO_ONLINE_ID=false
# NP_REQUIRE_CONSOLE_TOKEN=false
# NP_REDIRECT_PREFIXES=orbis://
# NP_ACCESS_TTL=1h

# Enable authenticated firmware ticket/profile/XMPP routes with an owner-local key:
# umask 077; openssl genpkey -algorithm ED25519 -out /secure/np-ticket-key.pem
# NP_TICKET_KEY=/secure/np-ticket-key.pem
# NP_XMPP_ADDR=127.0.0.1:8523
# NP_PROVISION_ACCOUNTS=true  # backfill all active users; repeat each minute for new users
# NP_SESSION_CLIENT=ps3      # set pier only when this listener is known to serve Pier
# NP_SESSION_OS=
# Optional owner-local 20-byte firmware trophy discovery compatibility key.
# NP_TROPHY_RESOURCE_KEY=/owner/local/trophy-resource-key.bin

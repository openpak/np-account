# Account core internal gRPC address + shared credential (>= 32 bytes).
NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!

# Sony's OAuth client credentials, embedded in the PS3 firmware's np_oauth module.
# Supply the real values here on the operator side; never commit them.
NP_CLIENT_ID=change-me
NP_CLIENT_SECRET=change-me

# Signs every token issued here (>= 32 bytes). Rotating it signs everyone out.
NP_TOKEN_KEY=change-me-token-signing-key-change-me-please!

NP_HTTP_ADDR=:8002

# Optional.
# NP_ENV_ISS_ID=1
# NP_COMM_DOMAIN=00
# NP_AUTO_ONLINE_ID=false
# NP_REQUIRE_CONSOLE_TOKEN=false
# NP_REDIRECT_PREFIXES=orbis://
# NP_ACCESS_TTL=1h

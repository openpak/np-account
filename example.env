# Operator-supplied values. Never commit real credentials.
NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!
NP_CLIENT_ID=change-me
NP_CLIENT_SECRET=change-me
NP_TOKEN_KEY=change-me-token-signing-key-change-me-please!
NP_HTTP_ADDR=:8002
NP_COMMUNITY_URL=http://openpak-np-community:8003
NP_TROPHY_URL=http://openpak-np-trophy:8531
# Keep the existing owner-local Ed25519 PKCS8 signing key to preserve tickets.
NP_TICKET_KEY=/run/ps3/np-ticket-key.pem
# Optional firmware-compatible TLS termination.
# NP_TLS_ADDR=:8443
# NP_TLS_CA_CERT=/run/ps3/ca.crt
# NP_TLS_CA_KEY=/run/ps3/ca.key
# NP_ENV_ISS_ID=1
# NP_COMM_DOMAIN=00
# NP_AUTO_ONLINE_ID=false
# NP_REQUIRE_CONSOLE_TOKEN=false
